{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/project/:path*", "destination": "/project.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
